# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mumy?retryWrites=true&w=majority
MONGODB_URI=""

# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Optional: enables real Gemini AI replies. Leave blank/unset to use the
# built-in French "simulation" fallback replies (no key required to demo the app).
GEMINI_API_KEY=""

# Google OAuth Client ID (from Google Cloud Console > APIs & Services > Credentials).
# Required for the "Sign in with Google" button; must match the frontend's
# VITE_GOOGLE_CLIENT_ID (same value, both sides need it).
GOOGLE_CLIENT_ID=""

PORT=4000

# Origin(s) allowed to call this API — comma-separated for multiple
# (e.g. production frontend URL + Vercel preview URLs).
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
